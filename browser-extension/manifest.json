{
  "manifest_version": 3,
  "name": "Eichhorn – Merken",
  "version": "1.0.0",
  "description": "Speichert die aktuelle Seite mit Video-Zeitpunkt, markiertem Text und Vorschaubild in der Eichhorn-App.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms"],
  "host_permissions": ["http://127.0.0.1:47123/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "In Eichhorn merken",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "merken": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Aktuelle Seite merken (mit Video-Zeitpunkt / markiertem Text)"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "eichhorn@thebigschabowski", "strict_min_version": "121.0" }
  }
}
